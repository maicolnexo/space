rules_version = '2';

/**
 * REGLAS CORREGIDAS — S.P.A.C.E / Checklist
 *
 * 1) NO usar match /{document=**} + allow true: eso abre TODA la base y anula el resto.
 * 2) Definir isAuthenticated() (antes faltaba en el pegado que compartiste).
 * 3) operators/create: si solo permitías role == "operator", usuarios web con rol admin fallaban al crear.
 *
 * Desplegar: firebase deploy --only firestore:rules
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdminDoc() {
      return exists(/databases/$(database)/documents/administradores/$(request.auth.uid));
    }

    // ----- Operadores (usuarios.html, app móvil) -----
    match /operators/{operatorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.name is string
        && request.resource.data.role is string
        && (!("activo" in request.resource.data) || request.resource.data.activo is bool);
      allow update: if isAuthenticated()
        && (!("activo" in request.resource.data) || request.resource.data.activo is bool);
      allow delete: if isAuthenticated();
    }

    // ----- Mensajes generales -----
    match /messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.content is string;
      allow update, delete: if isAuthenticated()
        && resource.data.senderId == request.auth.uid;
    }

    // ----- Chats privados -----
    match /private_chats/{chatId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants;
      allow delete: if false;
    }

    match /private_chats/{chatId}/messages/{messageId} {
      allow read: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.participants;
      allow create: if isAuthenticated()
        && request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.participants
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.content is string;
      allow update, delete: if isAuthenticated()
        && resource.data.senderId == request.auth.uid;
    }

    // ----- Usuarios -----
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.id == userId;
      allow update: if isAuthenticated()
        && request.auth.uid == userId;
      allow delete: if false;
    }

    // ----- Grupos -----
    match /groups/{groupId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.members;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.createdBy;
    }

    match /online_users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && request.auth.uid == userId;
    }

    match /administradores/{adminId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == adminId
        && request.resource.data.nombre is string
        && request.resource.data.email is string
        && request.resource.data.rol is string
        && request.resource.data.passwordEncrypted is string
        && request.resource.data.salt is string
        && request.resource.data.createdAt is number
        && request.resource.data.lastAccess is number
        && request.resource.data.active is bool;
      allow update: if isAuthenticated()
        && request.auth.uid == adminId;
      allow delete: if isAuthenticated()
        && request.auth.uid == adminId;
    }

    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.name is string
        && request.resource.data.role is string;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /checklist/{operatorDocId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /checklist/{operatorDocId}/records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.id is string
        && request.resource.data.parkingName is string
        && request.resource.data.operatorName is string
        && request.resource.data.date is number
        && request.resource.data.shift is string;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /pdf_button_states/{parking} {
      allow read, write: if isAuthenticated();
    }

    match /selecciones/{selectionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.parkingName is string
        && request.resource.data.operatorName is string
        && request.resource.data.section is string
        && request.resource.data.itemId is string
        && request.resource.data.itemDescription is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.isActive is bool;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ----- Cierres de caja -----
    match /cierres/{sede}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Recaudo POS (app): CIERRES/POS_{sede}_{YYYYMMDD}_{HHMMSS}
    match /CIERRES/{posDocId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ----- Planillado (todo el árbol: sede → Lug* / registros / …) -----
    match /planillado/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /planillado_old/{licensePlate} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.licensePlate is string
        && request.resource.data.dateTime is timestamp
        && request.resource.data.isCar is bool
        && request.resource.data.isMotorcycle is bool
        && request.resource.data.hasRadio is bool
        && request.resource.data.hasSpareTire is bool
        && request.resource.data.isDirty is bool
        && request.resource.data.description is string
        && request.resource.data.photosPaths is list
        && request.resource.data.user is string
        && request.resource.data.cellNumber is string
        && request.resource.data.keysNumber is string
        && request.resource.data.parking is string
        && request.resource.data.role is string
        && request.resource.data.lastOperator is string
        && request.resource.data.lastCheckDateTime is timestamp
        && request.resource.data.lastCheckTimestamp is number
        && request.resource.data.selectedParts is list
        && request.resource.data.partDamages is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (request.auth.uid == resource.data.user || isAdminDoc());
    }

    // Colecciones auxiliares del proyecto web (mensualidades, etc.)
    match /mensualidades/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // Programación de personal (programacion.html), un doc por semana (id = lunes YYYY-MM-DD)
    match /programacion_semanal/{weekId} {
      allow read, write: if isAuthenticated();
    }

    // Calendario diario (app móvil): programacion_dias/YYYY-MM-DD
    match /programacion_dias/{dayId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Catálogo de sedes (estacionamientos.html): nombre, dirección, teléfono
    match /sedes/{sedeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.nombre is string
        && request.resource.data.direccion is string
        && request.resource.data.telefono is string
        && (!("horaApertura" in request.resource.data) || request.resource.data.horaApertura is string)
        && (!("horaCierre" in request.resource.data) || request.resource.data.horaCierre is string)
        && (!("diasHabilitados" in request.resource.data) || request.resource.data.diasHabilitados is list)
        && (!("horarioPorDia" in request.resource.data) || request.resource.data.horarioPorDia is bool)
        && (!("horariosPorDia" in request.resource.data) || request.resource.data.horariosPorDia is map)
        && (!("servicio24h" in request.resource.data) || request.resource.data.servicio24h is bool)
        && (!("operariosRequeridos" in request.resource.data) || request.resource.data.operariosRequeridos is number)
        && (!("turnos" in request.resource.data) || request.resource.data.turnos is list)
        && (!("activo" in request.resource.data) || request.resource.data.activo is bool)
        && (!("cuposLote" in request.resource.data) || request.resource.data.cuposLote is number)
        && (!("limitarLote" in request.resource.data) || request.resource.data.limitarLote is bool)
        && (!("usarGruposLote" in request.resource.data) || request.resource.data.usarGruposLote is bool)
        && (!("motosPorCupoAuto" in request.resource.data) || request.resource.data.motosPorCupoAuto is number)
        && (!("gruposLote" in request.resource.data) || request.resource.data.gruposLote is list);
      allow update: if isAuthenticated()
        && request.resource.data.nombre is string
        && request.resource.data.direccion is string
        && request.resource.data.telefono is string
        && (!("horaApertura" in request.resource.data) || request.resource.data.horaApertura is string)
        && (!("horaCierre" in request.resource.data) || request.resource.data.horaCierre is string)
        && (!("diasHabilitados" in request.resource.data) || request.resource.data.diasHabilitados is list)
        && (!("horarioPorDia" in request.resource.data) || request.resource.data.horarioPorDia is bool)
        && (!("horariosPorDia" in request.resource.data) || request.resource.data.horariosPorDia is map)
        && (!("servicio24h" in request.resource.data) || request.resource.data.servicio24h is bool)
        && (!("operariosRequeridos" in request.resource.data) || request.resource.data.operariosRequeridos is number)
        && (!("turnos" in request.resource.data) || request.resource.data.turnos is list)
        && (!("activo" in request.resource.data) || request.resource.data.activo is bool)
        && (!("cuposLote" in request.resource.data) || request.resource.data.cuposLote is number)
        && (!("limitarLote" in request.resource.data) || request.resource.data.limitarLote is bool)
        && (!("usarGruposLote" in request.resource.data) || request.resource.data.usarGruposLote is bool)
        && (!("motosPorCupoAuto" in request.resource.data) || request.resource.data.motosPorCupoAuto is number)
        && (!("gruposLote" in request.resource.data) || request.resource.data.gruposLote is list);
      allow delete: if isAuthenticated();
    }

    // Vehículos en lote del POS (estacionamientos.html · Lotes y capacidad)
    match /POS/{sedeId}/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Registro inmutable de tiquetes POS purgados (motivo obligatorio desde la web)
    match /pos_tiquetes_purgados/{purgaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.placa is string
        && request.resource.data.sede is string
        && request.resource.data.motivoPurga is string
        && request.resource.data.motivoPurga.size() >= 10
        && request.resource.data.rutaPosOriginal is string
        && request.resource.data.purgadoPorUid is string
        && request.resource.data.purgadoEn is timestamp
        && request.resource.data.lotePurgaId is string;
      allow update, delete: if false;
    }

    // Plantillas térmicas (estacionamientos.html)
    match /plantillas_impresion/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Facturas de venta POS (recaudos.html)
    match /facturas_de_venta/{facturaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    match /caja_facturas/{facturaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Tarifas por sede (estacionamientos.html): tarifas/{idSede}
    match /tarifas/{sedeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated()
        && request.resource.data.sedeId is string
        && request.resource.data.tarifaPorMinuto is number
        && request.resource.data.tarifaPlena is number
        && request.resource.data.mensualidad is number
        && (!("iva" in request.resource.data) || request.resource.data.iva is number)
        && (!("moto" in request.resource.data) || request.resource.data.moto is map)
        && (!("bicicleta" in request.resource.data) || request.resource.data.bicicleta is map)
        && (!("ciclomotor" in request.resource.data) || request.resource.data.ciclomotor is map);
      allow delete: if isAuthenticated();
    }

    // Denegar explícito lo no contemplado (opcional; sin wildcard abierto)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
